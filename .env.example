BOT_TOKEN=Your bot token
BOT_CLIENT_ID=Your application (client) ID
SERVER_OWNER_ID=Server owner user ID
ADMIN_ROLE_ID=Your admin role ID, can add multiple separated by comma (ex: 123456789012345678,987654321098765432)

# Music system settings (OPTIONAL, NOT REQUIRED)
# DEFAULT_VOLUME=50       # Default volume (0-100)
# MUSIC_IDLE_TIMEOUT=300        # Auto-leave timeout in seconds (0 to disable)
# MUSIC_MAX_QUEUE_SIZE=100      # Maximum queue size

# YouTube / yt-dlp (OPTIONAL)
# YOUTUBE_PO_TOKEN=            # PO Token for YouTube (if bot detection hits)
# COOKIES_FROM_BROWSER=        # Browser name to load cookies from (ex: chrome)
# COOKIES_FILE=                # Path to a cookies.txt file (ex: cookies.txt)

# Spotify search (OPTIONAL)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Genius lyrics (OPTIONAL)
# GENIUS_CLIENT_ID=
# GENIUS_CLIENT_SECRET=

# Appearance (OPTIONAL)
# EMBED_COLOR=#5865f2
# STATUS=🎵 Lumiya | ;play